{
  "$comment": "Shared vectors for email handling. 'email' vectors are the canonical form (plus-tags and Gmail dots stripped): the app (shared/src/identifiers.ts canonicalEmail) and the api (CasaFit.Application/Auth/EmailIdentity.cs) must both pass them. expected null means the input is not an email address; the canonical check only runs the non-null ones. 'normalise' vectors are what the app sends to Supabase (trim and lower-case only). Rules: docs/data-model.md section 1.",
  "email": [
    {
      "input": "Asha@Example.com",
      "expected": "asha@example.com"
    },
    {
      "input": "  asha@example.com  ",
      "expected": "asha@example.com"
    },
    {
      "input": "asha+gym@example.com",
      "expected": "asha@example.com"
    },
    {
      "input": "a.s.h.a@gmail.com",
      "expected": "asha@gmail.com"
    },
    {
      "input": "A.Sha+tag@GMAIL.com",
      "expected": "asha@gmail.com"
    },
    {
      "input": "a.sha@example.com",
      "expected": "a.sha@example.com"
    },
    {
      "input": "no-at-sign",
      "expected": null
    },
    {
      "input": "@example.com",
      "expected": null
    },
    {
      "input": "asha@",
      "expected": null
    },
    {
      "input": "",
      "expected": null
    }
  ],
  "normalise": [
    {
      "input": "Asha@Example.com",
      "expected": "asha@example.com"
    },
    {
      "input": "  asha@example.com  ",
      "expected": "asha@example.com"
    },
    {
      "input": "asha+gym@example.com",
      "expected": "asha+gym@example.com"
    },
    {
      "input": "A.Sha@GMAIL.com",
      "expected": "a.sha@gmail.com"
    },
    {
      "input": "no-at-sign",
      "expected": null
    },
    {
      "input": "@example.com",
      "expected": null
    },
    {
      "input": "asha@",
      "expected": null
    },
    {
      "input": "asha@example",
      "expected": null
    },
    {
      "input": "a sha@example.com",
      "expected": null
    },
    {
      "input": "",
      "expected": null
    }
  ]
}
