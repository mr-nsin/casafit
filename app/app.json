{
  "expo": {
    "name": "CasaFit",
    "slug": "casafit",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "casafit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.casafit",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Form checks use the camera only while a check is running. Nothing is recorded, saved or uploaded.",
        "NSMotionUsageDescription": "Counts your daily steps on-device. No GPS, no location."
      }
    },
    "android": {
      "package": "app.casafit",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-audio",
      "expo-notifications",
      "react-native-health-connect",
      "./plugins/with-windows-build",
      ["expo-build-properties", { "android": { "compileSdkVersion": 37, "targetSdkVersion": 36, "minSdkVersion": 26 } }]
    ]
  }
}
