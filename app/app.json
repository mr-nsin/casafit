{
  "expo": {
    "name": "CasaFit",
    "slug": "casafit",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "casafit",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "bundleIdentifier": "app.casafit",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Form checks use the camera only while a check is running. Nothing is recorded, saved or uploaded.",
        "NSMotionUsageDescription": "Counts your daily steps on-device. No GPS, no location."
      }
    },
    "android": {
      "package": "app.casafit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#9C4400"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      ["expo-splash-screen", { "image": "./assets/brand/splash.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#9C4400" }],
      "expo-audio",
      "expo-notifications",
      "react-native-health-connect",
      "./plugins/with-windows-build",
      ["expo-build-properties", { "android": { "compileSdkVersion": 37, "targetSdkVersion": 36, "minSdkVersion": 26 } }]
    ]
  }
}
