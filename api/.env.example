# Copy to .env for local runs. Every setting is an environment variable; nothing is read from files in production.
# In a host (Railway, Cloud Run) set these in its dashboard or secret manager, never in the image.

# Postgres. Npgsql key=value form or a postgres:// URL (Railway and Supabase hand out URLs).
ConnectionStrings__Default="Host=localhost;Port=5432;Database=casafit;Username=casafit;Password=casafit"

# Supabase Auth is the identity provider. The app signs in with Supabase and sends its access token as a Bearer token.
# Project URL (gives the token issuer, the JWKS and the admin API).
Supabase__Url="https://your-project.supabase.co"
# Legacy HS256 JWT secret (Project settings, API, JWT secret). Optional: leave empty if the project uses asymmetric
# signing keys, which are verified through the JWKS at Supabase__Url. Set it if tokens are still HS256. 32+ characters.
Supabase__JwtSecret=""
# Server-only service_role key. Used to delete a user (DELETE /v1/me). Never ship it in the app. Required outside Development.
Supabase__ServiceRoleKey=""

# RevenueCat webhook: the value of the Authorization header configured in the RevenueCat dashboard. Sent exactly as set.
# Generate: openssl rand -base64 32
RevenueCat__WebhookSecret="change-me-webhook-secret"

# Server-side pepper for hashing identifiers on the deleted-account list. 16+ characters. Never rotate casually.
Auth__Pepper="change-me-pepper-16-plus-chars"

# Folder with exercises.json, plans.json, foods.json, learn.json (served at /v1/content/packs/{name}).
# Locally: the app's assets. The Docker image copies them to /app/content at build time.
Content__Directory="../app/assets/content"

# Apply EF Core migrations when the process starts (fine for one instance; run them from CI for more).
Database__MigrateOnStartup="true"

# Per-IP limit on requests per minute, across all endpoints.
RateLimit__PerMinute="240"

# Honoured by Railway and Cloud Run. Leave unset locally (dotnet run uses 5080, the image uses 8080).
# PORT="8080"
