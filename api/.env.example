# Copy to .env for local runs. Every setting is an environment variable; nothing is read from files in production.
# In a host (Railway, Cloud Run) set these in its dashboard or secret manager, never in the image.

# Postgres. Npgsql key=value form or a postgres:// URL (Railway and Supabase hand out URLs).
ConnectionStrings__Default="Host=localhost;Port=5432;Database=casafit;Username=casafit;Password=casafit"

# Redis (OTP codes, resend and hourly counters). redis:// or rediss:// (Upstash, TLS).
# Leave empty for a single-instance in-memory store, local runs only.
Redis__Url="redis://localhost:6379"

# JWT signing. Secret must be 32+ characters. Generate: openssl rand -base64 48
Jwt__Secret="change-me-to-a-long-random-string-of-32-plus-chars"
Jwt__Issuer="casafit-api"
Jwt__Audience="casafit-app"
Jwt__AccessTtlSeconds="900"
Jwt__RefreshTtlSeconds="2592000"

# Server-side pepper for hashing identifiers and codes. 16+ characters. Never rotate casually:
# it also protects the deleted-account hash list.
Auth__Pepper="change-me-pepper-16-plus-chars"

# Vendors. Only dev fakes exist so far: 'log' prints a masked destination and the code, makes no vendor call.
Sms__Provider="log"
Attestation__Provider="dev"

# Apply EF Core migrations when the process starts (fine for one instance; run them from CI for more).
Database__MigrateOnStartup="true"

# Per-IP limit on /v1/auth/* requests per minute.
RateLimit__AuthPerMinute="30"

# Honoured by Railway and Cloud Run. Leave unset locally (dotnet run uses 5080, the image uses 8080).
# PORT="8080"
