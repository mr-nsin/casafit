  "components": {
    "schemas": {
      "ConsentResponse": {
        "required": [
          "id",
          "type",
          "granted",
          "policyVersion",
          "recordedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string"
          },
          "granted": {
            "type": "boolean"
          },
          "policyVersion": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ConsumeRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string"
          },
          "exercise": {
            "type": "string"
          }
        }
      },
      "ConsumeResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "freeChecksRemaining": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ContentVersionResponse": {
        "required": [
          "foodPack",
          "exercises"
        ],
        "type": "object",
        "properties": {
          "foodPack": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "exercises": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EntitlementsStatus": {
        "required": [
          "freeChecksRemaining",
          "pro"
        ],
        "type": "object",
        "properties": {
          "freeChecksRemaining": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pro": {
            "$ref": "#/components/schemas/ProState"
          }
        }
      },
      "ExportAccount": {
        "required": [
          "id",
          "phone",
          "email",
          "locale",
          "onboarded",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "locale": {
            "type": "string"
          },
          "onboarded": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExportResponse": {
        "required": [
          "generatedAt",
          "account",
          "plan",
          "consents",
          "sessions",
          "food",
          "steps"
        ],
        "type": "object",
        "properties": {
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "$ref": "#/components/schemas/ExportAccount"
          },
          "plan": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PlanResponse"
              }
            ]
          },
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentResponse"
            }
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SessionEntry"
            }
          },
          "food": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FoodEntryDto"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepEntry"
            }
          }
        }
      },
      "FoodEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "loggedOn": {
            "type": "string",
            "format": "date"
          },
          "meal": {
            "type": "string"
          },
          "foodId": {
            "type": "string"
          },
          "portions": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "locale",
          "onboarded",
          "createdAt",
          "freeChecksRemaining",
          "pro",
          "plan"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "locale": {
            "type": "string"
          },
          "onboarded": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "freeChecksRemaining": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pro": {
            "$ref": "#/components/schemas/ProState"
          },
          "plan": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PlanResponse"
              }
            ]
          }
        }
      },
      "PlanResponse": {
        "required": [
          "goal",
          "styles",
          "days",
          "experience",
          "variant",
          "weekNumber",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          },
          "styles": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "days": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "experience": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "weekNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProState": {
        "required": [
          "active",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "active": {
            "type": "boolean"
          },
          "expiresAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecordConsentRequest": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "granted": {
            "type": "boolean"
          },
          "policyVersion": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RefundRequest": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string"
          },
          "consumeIdempotencyKey": {
            "type": "string"
          },
          "repsCompleted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RefundResponse": {
        "required": [
          "ok",
          "freeChecksRemaining"
        ],
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "freeChecksRemaining": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "RevenueCatEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "app_user_id": {
            "type": "string"
          },
          "event_timestamp_ms": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "expiration_at_ms": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int64"
          }
