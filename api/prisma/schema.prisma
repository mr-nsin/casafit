// CasaFit · Prisma schema
// Mirrors docs/data-model.md. Keep in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                  String   @id @default(uuid()) @db.Uuid
  phoneE164           String?  @unique
  emailNorm           String?  @unique
  createdAt           DateTime @default(now())
  locale              String   @default("en-IN")
  onboarded           Boolean  @default(false)
  freeChecksRemaining Int      @default(2)
  proActive           Boolean  @default(false)
  proExpiresAt        DateTime?

  plan        Plan?
  otpAttempts OtpAttempt[]
  checks      FormCheckEvent[]
}

model Plan {
  accountId    String   @id @db.Uuid
  goal         String
  stylesMask   Int      // bitmask: 1=normal, 2=yoga, 4=dance
  daysPerWeek  Int
  experience   String
  flagsJson    String   // small JSON blob of pain and health flags
  weekNumber   Int      @default(1)
  updatedAt    DateTime @updatedAt

  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model OtpAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  accountId  String?  @db.Uuid
  identifier String   // E.164 phone or normalised email, hashed before store
  channel    String   // 'phone' | 'email'
  createdAt  DateTime @default(now())
  success    Boolean  @default(false)

  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([identifier, createdAt])
}

model FormCheckEvent {
  id               String   @id @default(uuid()) @db.Uuid
  accountId        String   @db.Uuid
  kind             String   // 'consume' | 'refund'
  idempotencyKey   String
  at               DateTime @default(now())

  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, kind, idempotencyKey])
}

model DeletedIdentifierHash {
  hash       Bytes    @id
  deletedAt  DateTime @default(now())
  expiresAt  DateTime
}
